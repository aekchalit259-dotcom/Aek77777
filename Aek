-- AI Engine Logic
local function ProcessAIResponse(userText)
    local text = string.lower(userText)
    
    if CurrentLang == "TH" then
        if string.find(text, "ฟังชั่น") or string.find(text, "ทำไรได้") or string.find(text, "มีอะไรบ้าง") then
            return "มีตามนี้เลยครับ บิน วิ่ง ล่องหน ทะลุ วาร์ป และ แชทAi ครับ"
        elseif string.find(text, "หวัดดี") or string.find(text, "สวัสดี") or string.find(text, "hello") then
            return "สวัสดีครับเอก! ผมคือ AI AEKHUB พร้อมช่วยเหลือครับ"
        elseif string.find(text, "ใครสร้าง") then
            return "สคริปต์นี้สร้างโดย เอกชอบสร้างสคริปต์ ครับ!"
        else
            return "AI AEKHUB ได้รับคำถามแล้ว: '" .. userText .. "' (ระบบพร้อมตอบทุกคำถามครับ!)"
        end
    elseif CurrentLang == "EN" then
        if string.find(text, "function") or string.find(text, "feature") or string.find(text, "what") then
            return "Available features: Fly, Fast Speed, Invisible, Noclip, Teleport, and AI Chat!"
        else
            return "AI AEKHUB Response: I understand your query about '" .. userText .. "'."
        end
    elseif CurrentLang == "FR" then
        if string.find(text, "fonction") or string.find(text, "option") then
            return "Fonctionnalités disponibles: Voler, Vitesse, Invisible, Noclip, Téléportation et Chat AI!"
        else
            return "AI AEKHUB Réponse: J'ai reçu votre message: '" .. userText .. "'."
        end
    end
end

local function SendMessage()
    local text = InputBox.Text
    if text ~= "" then
        AddChatMessage("เอก", text, Color3.fromRGB(255, 255, 255))
        InputBox.Text = ""
        task.wait(0.3)
        local reply = ProcessAIResponse(text)
        AddChatMessage("AI AEKHUB", reply, ChatThemeColor)
    end
end

SendBtn.MouseButton1Click:Connect(SendMessage)
InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then SendMessage() end
end)

